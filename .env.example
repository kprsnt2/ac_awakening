# Project Awakening Configuration
# The primary engine uses OpenAI API with gpt-5.4-mini
OPENAI_API_KEY=sk-...

# Agent Model (default: gpt-5.4-mini)
AGENT_MODEL=gpt-5.4-mini

# Optional custom base URL (e.g. for proxies or OpenRouter)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Port for local web viewer
PORT=3001
